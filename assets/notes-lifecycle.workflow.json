      "tag": "In-place Sync",
      "width": 140
    },
    {
      "id": "superseded",
      "lane": "active",
      "col": 3,
      "type": "backend",
      "label": "被新方案取代",
      "sublabel": "将独特理由搬入新代 Note",
      "tag": "Supersession",
      "width": 140
    },
    {
      "id": "archived",
      "lane": "frozen",
      "col": 4,
      "type": "cloud",
      "label": "archived/ 封存",
      "sublabel": "永久封印入 manifest.json",
      "tag": "SHA-256 锁定",
      "width": 140
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "idea",
      "to": "proposed",
      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "proposed",
      "to": "implemented",
      "label": "评审通过交付",
      "variant": "emphasis"
    },
    {
      "id": "e3",
      "from": "proposed",
      "to": "rejected",
      "label": "方案被否决",
      "variant": "security"
    },
    {
      "id": "e4",
      "from": "implemented",
      "to": "sync",
      "label": "代码小幅重构",
      "variant": "default"
    },
    {
      "id": "e5",
      "from": "sync",
      "to": "implemented",
      "label": "就地更新事实",
      "variant": "default"
    },
    {
      "id": "e6",
      "from": "implemented",
      "to": "superseded",
      "label": "新架构出现",
      "variant": "emphasis"
    },
    {
      "id": "e7",
      "from": "superseded",
      "to": "archived",
      "label": "归档封存",
      "variant": "security"
    }
