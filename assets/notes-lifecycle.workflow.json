  "cards": [
    {
      "dot": "emerald",
      "title": "状态机铁律",
      "items": [
        "implemented 状态严禁出现 Plan/Proposal 词汇，全篇必须是现在时事实",
        "rejected 仅当其理由能避免重蹈覆辙时保留，否则彻底删除"
      ]
    },
    {
      "dot": "rose",
      "title": "冻结与防腐",
      "items": [
        "进入 archived/ 的文件永久计算 SHA-256 封印在 manifest.json",
        "归档文件跳过日常 CI 语法扫描，释放团队日常维护心智负担"
      ]
    }
  ]
}