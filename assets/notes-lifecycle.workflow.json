    },
    {
      "id": "sync_lane",
      "label": "日常迭代维护 (Daily Evolution)"
    },
    {
      "id": "frozen",
      "label": "冻结封存记录 (Frozen Archive)"
    }
  ],
  "phases": [
    {
      "id": "p1",
      "label": "1. 提案与评审",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "p2",
      "label": "2. 交付与现行演进",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "p3",
      "label": "3. 取代与封存",
      "fromCol": 4,
      "toCol": 4,
      "variant": "dashed"
    }
  ],
  "nodes": [
    {
      "id": "idea",
      "lane": "draft",
      "col": 0,
      "type": "frontend",
      "label": "架构构想产生",
      "sublabel": "技术选型 / 模块重构",
      "width": 140
    },
    {
      "id": "proposed",
      "lane": "draft",
      "col": 1,
      "type": "backend",
      "label": "proposed/ 提案",
      "sublabel": "写清背景与强制反稻草人备选",
      "width": 140
    },
    {
      "id": "rejected",
      "lane": "frozen",
      "col": 1,
      "type": "security",
      "label": "rejected/ 否决",
      "sublabel": "一句话原因留痕，防后人重犯",
      "tag": "防反复翻案",
      "width": 140
    },
    {
      "id": "implemented",
      "lane": "active",
      "col": 2,
      "type": "backend",
      "label": "implemented/ 现行",
      "sublabel": "现在时 Decision，与代码原子提交",
      "tag": "现行法律",
      "width": 140
    },
    {
      "id": "sync",
      "lane": "sync_lane",
      "col": 2,
      "type": "database",
      "label": "80% 原地事实同步",
